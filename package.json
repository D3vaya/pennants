{
  "name": "pennants",
  "version": "0.1.0",
  "description": "Lightweight country flags in pennant (banderín) style — SVG, PNG, CSS, sprite, JS, React and Web Component.",
  "keywords": [
    "flags",
    "country-flags",
    "pennant",
    "banderin",
    "svg",
    "icons",
    "css",
    "react",
    "web-component",
    "iso-3166"
  ],
  "license": "MIT",
  "author": "d3vaya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3vaya/pennants.git"
  },
  "homepage": "https://github.com/d3vaya/pennants#readme",
  "bugs": {
    "url": "https://github.com/d3vaya/pennants/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/element/register.js"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "svg",
    "png",
    "css",
    "sprite/pennant.svg",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/static": {
      "types": "./dist/react/static.d.ts",
      "default": "./dist/react/static.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./element/register": {
      "types": "./dist/element/register.d.ts",
      "default": "./dist/element/register.js"
    },
    "./art/*": {
      "types": "./dist/art/*.d.ts",
      "default": "./dist/art/*.js"
    },
    "./css": {
      "types": "./css/pennants.d.ts",
      "default": "./css/pennant.min.css"
    },
    "./css/cdn": {
      "types": "./css/pennants.d.ts",
      "default": "./css/pennant.cdn.min.css"
    },
    "./css/rect": {
      "types": "./css/pennants.d.ts",
      "default": "./css/rect.min.css"
    },
    "./css/rect/cdn": {
      "types": "./css/pennants.d.ts",
      "default": "./css/rect.cdn.min.css"
    },
    "./css/square": {
      "types": "./css/pennants.d.ts",
      "default": "./css/square.min.css"
    },
    "./css/square/cdn": {
      "types": "./css/pennants.d.ts",
      "default": "./css/square.cdn.min.css"
    },
    "./css/circle": {
      "types": "./css/pennants.d.ts",
      "default": "./css/circle.min.css"
    },
    "./css/circle/cdn": {
      "types": "./css/pennants.d.ts",
      "default": "./css/circle.cdn.min.css"
    },
    "./css/*": {
      "types": "./css/pennants.d.ts",
      "default": "./css/*"
    },
    "./svg/*": "./svg/*",
    "./png/*": "./png/*",
    "./sprite": "./sprite/pennant.svg",
    "./sprite/*": "./sprite/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "npm run generate && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only --entrypoints . ./art/1x1/ar ./fetch ./react ./react/static ./element ./element/register && node scripts/pack-budget.ts",
    "size": "size-limit",
    "examples:check": "node scripts/examples-check.ts",
    "bundle:budget": "node scripts/bundle-budget.ts",
    "verify": "npm run lint && npm run build && npm run typecheck && npm run coverage && npm run check:package && npm run size",
    "prepublishOnly": "npm run verify",
    "docs:api": "typedoc --options docs/typedoc.json && node scripts/docs-api.ts",
    "docs:dev": "node scripts/docs-assets.ts && npm run docs:api && vitepress dev docs",
    "docs:build": "npm run build && node scripts/docs-assets.ts && npm run docs:api && node scripts/docs-readme-sizes.ts --check && vitepress build docs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "flag-icons": "^7.6.0",
    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "size-limit": "^14.3.0",
    "svgo": "^4.1.0",
    "tsup": "^9.0.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitepress": "1.6.4",
    "vitest": "^5.0.5"
  }
}
