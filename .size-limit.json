[
  {
    "name": "core: isPennantCode",
    "path": "dist/index.js",
    "import": "{ isPennantCode }",
    "limit": "1 kB"
  },
  {
    "name": "core entry incl. loadPennant (flag chunks excluded)",
    "path": "dist/index.js",
    "rolldown": false,
    "limit": "5 kB"
  },
  {
    "name": "react",
    "path": "dist/react/index.js",
    "ignore": ["react", "react-dom", "react/jsx-runtime"],
    "limit": "3 kB"
  },
  {
    "name": "element",
    "path": "dist/element/index.js",
    "limit": "3 kB"
  },
  {
    "name": "one flag (ar)",
    "path": "dist/flags/ar.js",
    "rolldown": false,
    "limit": "2 kB"
  },
  {
    "name": "css",
    "path": "css/pennants.min.css",
    "rolldown": false,
    "limit": "10 kB"
  }
]
